# =============================================================================
# JobConnect - Environment Variables
# =============================================================================

# Flask Environment
FLASK_ENV=production

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Application
APP_NAME=JobConnect

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@host:5432/jobconnect

# Language
BABEL_DEFAULT_LOCALE=es

# File uploads
UPLOAD_FOLDER=uploads

# Scraping
SCRAPING_TIMEOUT=30

# Cache
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@jobconnect.com

# JobSpy Settings
JOBSPY_COUNTRY=USA
JOBSPY_RESULTS_WANTED=25
JOBSPY_HOURS_OLD=168

# API Keys (Add your actual API keys)
INDEED_API_KEY=your-indeed-api-key
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
GOOGLE_JOBS_API_KEY=your-google-jobs-api-key