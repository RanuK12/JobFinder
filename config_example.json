{
  "application": {
    "name": "JobConnect",
    "environment": "production",
    "debug": false,
    "secret_key": "your-super-secret-key-change-this-in-production"
  },
  "database": {
    "url": "postgresql://user:password@host:5432/jobconnect",
    "track_modifications": false,
    "echo": false
  },
  "email": {
    "server": "smtp.gmail.com",
    "port": 587,
    "use_tls": true,
    "username": "your-email@gmail.com",
    "password": "your-app-password",
    "default_sender": "noreply@jobconnect.com"
  },
  "file_uploads": {
    "max_content_length": 16777216,
    "upload_folder": "uploads",
    "allowed_extensions": ["pdf", "docx", "doc"]
  },
  "jobspy": {
    "sites": ["indeed", "linkedin", "google", "zip_recruiter"],
    "country": "USA",
    "results_wanted": 25,
    "hours_old": 168
  },
  "api_keys": {
    "indeed": "your-indeed-api-key",
    "linkedin_client_id": "your-linkedin-client-id",
    "linkedin_client_secret": "your-linkedin-client-secret",
    "google_jobs": "your-google-jobs-api-key"
  },
  "scraping": {
    "timeout": 30,
    "max_retries": 3,
    "delay": [1, 3]
  },
  "cache": {
    "type": "SimpleCache",
    "default_timeout": 300
  },
  "rate_limiting": {
    "default": "200 per day;50 per hour;10 per minute",
    "storage_url": "memory://",
    "strategy": "fixed-window"
  },
  "logging": {
    "level": "INFO",
    "dir": "static/logs"
  },
  "session": {
    "permanent_lifetime_days": 30,
    "cookie_duration_days": 365,
    "cookie_secure": false,
    "cookie_httponly": true,
    "cookie_samesite": "Lax"
  },
  "internationalization": {
    "default_locale": "es",
    "default_timezone": "UTC",
    "languages": {
      "en": "English",
      "es": "Español",
      "it": "Italiano"
    }
  },
  "jobs": {
    "max_per_page": 50,
    "expiration_days": 30
  },
  "users": {
    "max_per_page": 50
  }
}