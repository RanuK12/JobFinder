# Flask Environment
FLASK_ENV=development

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=jobconnect-dev-secret-key-change-in-production-2024

# Application
APP_NAME=JobConnect

# Database (SQLite for development)
DATABASE_URL=sqlite:///instance/jobconnect.db

# Language
BABEL_DEFAULT_LOCALE=es

# File uploads
UPLOAD_FOLDER=uploads

# Scraping
SCRAPING_TIMEOUT=30

# Cache
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO

# Email Configuration (development placeholder)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@jobconnect.com

# JobSpy Settings
JOBSPY_COUNTRY=USA
JOBSPY_RESULTS_WANTED=25
JOBSPY_HOURS_OLD=168

# API Keys (placeholder values - replace with actual keys)
INDEED_API_KEY=your-indeed-api-key
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
GOOGLE_JOBS_API_KEY=your-google-jobs-api-key